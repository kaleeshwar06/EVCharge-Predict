# ─────────────────────────────────────────────────────────────────────────────
# EVCharge-Predict — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# --- Application ---
APP_ENV=development            # development | production
API_VERSION=1.0
LOG_LEVEL=INFO

# --- FastAPI server (Uvicorn) ---
HOST=127.0.0.1
PORT=8001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/evcharge_predict

# --- EVCharge-Opt partner API ---
EVCHARGE_OPT_BASE_URL=http://127.0.0.1:8000
EVCHARGE_OPT_API_KEY=replace-me

# --- CORS ---
FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- Security & Service Authentication ---
SECRET_KEY=replace-with-a-long-random-string
# API_AUTH_TOKEN: Configured for future production service-to-service authentication.
# NOTE: In local development, endpoints are currently unauthenticated. Production deployment must configure bearer token validation before public exposure.
API_AUTH_TOKEN=replace-with-service-token
