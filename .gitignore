# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
.env
.env.*
!.env.example

# pytest
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
*.tsbuildinfo

# ─── Secrets ──────────────────────────────────────────────────────────────────
*.pem
*.key
*.p12

# ─── Databases ────────────────────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── ML artifacts (trained models / checkpoints) ──────────────────────────────
# Keep models/manifest tracked so the service runs immediately when cloned
!artifacts/models/
!artifacts/models/*

# ─── Datasets ─────────────────────────────────────────────────────────────────
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
!data/processed/station_mapping.json
!data/processed/partner_feedbacks.json


# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp
*.dump
evcharge_opt_openapi.json
