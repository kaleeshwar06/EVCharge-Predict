# EVCharge-Predict Frontend Environment Configuration
# For local development with Vite dev server (uses local proxy to 127.0.0.1:8001):
# Leave VITE_API_BASE_URL empty or unset.
# VITE_API_BASE_URL=

# For standalone production deployment on Render Static Site:
# Set to your deployed backend URL:
# VITE_API_BASE_URL=https://evcharge-predict.onrender.com
